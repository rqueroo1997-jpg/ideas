# Postgres connection string. In this dev container a local Postgres 16
# cluster is already running with a `sigo` database and postgres/postgres
# credentials — copy this file to .env and adjust for your own environment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sigo?schema=public"

# 32+ byte random secret used to encrypt the iron-session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-byte-secret"

# Anthropic API key for the real AI-assisted search in Papeleo (Phase 4).
ANTHROPIC_API_KEY=""
